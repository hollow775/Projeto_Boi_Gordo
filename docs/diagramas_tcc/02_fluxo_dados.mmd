flowchart TD
    TITULO["Fluxo de dados do projeto"]
    A["Arquivos e APIs brutas\nCEPEA, BCB, SIDRA, ComexStat, Copernicus"] --> B["Coletores\nsrc/collectors"]
    B --> C["Dados brutos ou cacheados\ndata/raw e caches locais"]
    C --> D["Limpeza\nsrc/processing/cleaner.py"]
    D --> E["Junção temporal\nsrc/processing/merger.py"]
    E --> F["Deflação e alinhamento diário\npreços em base comparável"]
    F --> G["Engenharia de atributos\nsrc/features/engineering.py"]
    G --> H["Variáveis explicativas\nlags, médias móveis, variações e calendário"]
    H --> I["Alvos de previsão\nhorizontes de 1, 7, 15, 30 e 60 dias"]
    I --> J["Treino e avaliação\nsrc/models/train.py e evaluate.py"]
    J --> K["Modelos salvos\nmodels_saved"]
    J --> L["Métricas e gráficos\ndata/processed"]
    K --> M["Predição\nsrc/models/predict.py"]
    M --> N["Saídas para interface e site\ndata/outputs"]
