flowchart TD
    TITULO["Fluxo de dados do projeto"]
    A["Arquivos e APIs brutas<br/>CEPEA, BCB, SIDRA, ComexStat, Copernicus"] --> B["Coletores<br/>src/collectors"]
    B --> C["Dados brutos ou cacheados<br/>data/raw e caches locais"]
    C --> D["Limpeza<br/>src/processing/cleaner.py"]
    D --> E["Junção temporal<br/>src/processing/merger.py"]
    E --> F["Deflação e alinhamento diário<br/>preços em base comparável"]
    F --> G["Engenharia de atributos<br/>src/features/engineering.py"]
    G --> H["Variáveis explicativas<br/>lags, médias móveis, variações e calendário"]
    H --> I["Alvos de previsão<br/>horizontes de 1, 7, 15, 30 e 60 dias"]
    I --> J["Treino e avaliação<br/>src/models/train.py e evaluate.py"]
    J --> K["Modelos salvos<br/>models_saved"]
    J --> L["Métricas e gráficos<br/>data/processed"]
    K --> M["Predição<br/>src/models/predict.py"]
    M --> N["Saídas para interface e site<br/>data/outputs"]
